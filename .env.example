# Copie este arquivo para .env e preencha com seus dados reais
# O arquivo .env NUNCA deve ser commitado no Git!

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ello_mineiro
DB_SSL=false

# Autenticação (JWT)
JWT_SECRET=sua_chave_secreta_longa_e_aleatoria_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Chave Privada da Aplicação (Proteção de Rotas de Mutabilidade via X-API-Key)
# Usada por integrações, scripts externos e Postman. O frontend do site usa handshake de mesma origem.
API_KEY=sua_chave_privada_da_aplicacao_aqui

